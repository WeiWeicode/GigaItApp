# 複製為 .env(不入版控);部署區差異見 AGENT.md §4
# dev:本機開發 / test:測試區 / prod:正式區
IT_ENV=dev
PORT=51291
# 資料檔目錄(JSON,第一次啟動自動建立種子資料)
DATA_DIR=data
# Session 簽章金鑰(至少 32 字元);dev 未設定時每次啟動隨機產生,test / prod 一律用 _FILE
# ITAPP_JWT_SECRET=
# ITAPP_JWT_SECRET_FILE=/run/secrets/itapp_jwt_secret
# 第一次啟動建立種子帳號的密碼;dev 預設 Passw0rd!(虛構帳號)
# ITAPP_SEED_PASSWORD_FILE=/run/secrets/itapp_seed_password
# 本機 http 開發時 Cookie 不加 Secure;經 Nginx https 時設 true(test / prod 預設 true)
# COOKIE_SECURE=false

# ---- Gateway BFF ----
# mock:使用內建快照(離線開發,預設);live:以服務帳號登入 BFF 讀取管理資料
BFF_MODE=mock
# BFF_BASE_URL=https://localhost
# BFF_SERVICE_USER=S100001
# BFF_SERVICE_PASSWORD=Passw0rd!
# BFF_SERVICE_PASSWORD_FILE=/run/secrets/bff_service_password
# 開發用自簽憑證
# NODE_EXTRA_CA_CERTS=../../giga-api-gateway-bff/deploy/dev/secrets/pki/ca.crt
# BFF_TIMEOUT_MS=8000
# BFF_CACHE_TTL_SEC=30
